{
  "appId": "com.raasdiary.app",
  "appName": "Raa's Diary",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#060914",
    "preferredContentMode": "mobile"
  },
  "android": {
    "backgroundColor": "#060914",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#060914",
      "showSpinner": false
    }
  }
}
